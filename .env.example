# Copy to .env and use the hostnames your devices resolve to the Caddy server.
OPENCHORE_DOMAIN=localhost
OPENGYM_DOMAIN=opengym.localhost
# OpenGym's HTTP address, reachable from the Caddy container.
OPENGYM_UPSTREAM=host.docker.internal:8095

# Optional phone reminders: generate keys with scripts/generate-vapid-keys.mjs.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:admin@example.com
